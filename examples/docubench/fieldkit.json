{
  "schema_version": "0.1",
  "benchmark": {
    "name": "DocuBench",
    "version": "external-checkout",
    "workdir": "${DOCUBENCH_HOME}",
    "run": [
      "python3", "${FIELDKIT_HOME}/examples/docubench/ollama_subset.py",
      "--repo", "${DOCUBENCH_HOME}",
      "--engine", "ollama-ministral3-vision-v1",
      "--model", "ministral-3:latest",
      "--mode", "vision",
      "--doc-id", "vBIz5dut",
      "--doc-id", "ZXlksSpk",
      "--doc-id", "NNaGgwE5",
      "--doc-id", "nESapyAA",
      "--doc-id", "B0nA2c30"
    ],
    "native_results": [
      "results/ollama-ministral3-vision-v1/vBIz5dut.json",
      "results/ollama-ministral3-vision-v1/ZXlksSpk.json",
      "results/ollama-ministral3-vision-v1/NNaGgwE5.json",
      "results/ollama-ministral3-vision-v1/nESapyAA.json",
      "results/ollama-ministral3-vision-v1/B0nA2c30.json",
      "results/ollama-ministral3-vision-v1-fieldkit-summary.json"
    ],
    "metrics": {
      "quality.aggregate": {
        "file": "results/ollama-ministral3-vision-v1-fieldkit-summary.json",
        "path": "aggregate"
      },
      "quality.document_count": {
        "file": "results/ollama-ministral3-vision-v1-fieldkit-summary.json",
        "path": "document_count"
      },
      "resources.ollama_vram_bytes": {
        "file": "results/ollama-ministral3-vision-v1-fieldkit-summary.json",
        "path": "resources.ollama_vram_bytes"
      }
    }
  },
  "deployment": {
    "name": "local-ollama-evaluation",
    "policy": {
      "name": "docubench-starter-smoke-v0.1",
      "status": "example-not-production",
      "rationale": "Exercises integration behavior; thresholds are not production recommendations."
    },
    "timeout_seconds": 7200,
    "network": {"mode": "local-service-not-enforced"},
    "gates": [
      {"metric": "quality.aggregate", "op": "exists"},
      {"metric": "quality.document_count", "op": "==", "value": 5},
      {"metric": "runtime.exit_code", "op": "==", "value": 0}
    ]
  }
}
